<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Kumes</AssemblyName>
    <Version>1.5</Version>
    <RootNamespace>Kumes</RootNamespace>
    <!-- Az RAM: tek iş parçacıklı, arka planda çalışmayan GC -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Kümes logosu: exe, görev çubuğu ve pencere simgesi -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- logo görselleri (sol menü, tray) exe'nin içine gömülür -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="Kumes.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ortak kod: Steam, CS2 tavuk verisi, süre biçimleri (mobil de kullanır) -->
    <ProjectReference Include="..\Kumes.Core\Kumes.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="ValveResourceFormat" Version="20.1.7467" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

</Project>
